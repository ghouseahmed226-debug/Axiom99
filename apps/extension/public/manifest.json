{
    "permissions":  [
                        "storage",
                        "alarms",
                        "notifications",
                        "identity",
                        "tabs"
                    ],
    "description":  "The open-source browser-native game console. Play anywhere.",
    "short_name":  "NexusWeb",
    "manifest_version":  3,
    "version":  "0.1.0",
    "host_permissions":  [
                             "https://*.nexusweb.gg/*"
                         ],
    "background":  {
                       "type":  "module",
                       "service_worker":  "background.js"
                   },
    "name":  "NexusWeb Console",
    "web_accessible_resources":  [
                                     {
                                         "matches":  [
                                                         "\u003call_urls\u003e"
                                                     ],
                                         "resources":  [
                                                           "icons/*",
                                                           "fonts/*"
                                                       ]
                                     }
                                 ],
    "icons":  {
                  "16":  "icons/icon-16.png",
                  "128":  "icons/icon-128.png",
                  "48":  "icons/icon-48.png"
              },
    "action":  {
                   "default_icon":  {
                                        "48":  "icons/icon-48.png"
                                    },
                   "default_popup":  "popup.html"
               },
    "content_scripts":  [
                            {
                                "run_at":  "document_idle",
                                "matches":  [
                                                "\u003call_urls\u003e"
                                            ],
                                "js":  [
                                           "content.js"
                                       ]
                            }
                        ]
}
